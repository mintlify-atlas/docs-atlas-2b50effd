  "keyFeatures": [
    "Ed25519-signed attestations — tamper-evident posture records, verifiable by auditors",
    "13 posture checks across macOS, Windows, and Linux (disk encryption, firewall, EDR, screen lock, and more)",
    "Zero-infrastructure server on Cloudflare Workers + D1 — free tier covers ~50 devices",
    "One-command agent enrollment with automatic daemon installation",
    "Compliance drift detection — immediate attestation on posture change",
    "Admin UI with device list, compliance status, and credential management",
    "Offline-resilient retry queue — attestations queued and replayed when connectivity returns",
    "Cloudflare Access integration for SSO/MFA protection of the admin UI"
  ],
  "publicApiSurface": [
    "GET /health",
    "GET /enroll/:token",
